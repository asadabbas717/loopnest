# Public client configuration only. Never put a secret/service_role key here.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
EXPO_PUBLIC_USE_LOCAL_BACKEND=false
# Temporary UI testing only; ignored in release builds. Restart Metro and Expo Go after changing.
EXPO_PUBLIC_ALLOW_TEST_SCREENSHOTS=false
