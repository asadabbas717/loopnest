{
  "name": "loopnest",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "expo-router/entry",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "expo start",
    "start:device": "expo start --go --lan",
    "backend:start": "node scripts/backend.mjs start",
    "backend:stop": "node scripts/backend.mjs stop",
    "backend:env": "node scripts/backend.mjs env",
    "maintenance:photos": "node scripts/maintenance.mjs",
    "test:integration": "node --test integration/*.test.mjs",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run typecheck && npm run lint && npm test",
    "format": "prettier --write src tests scripts integration ../supabase/functions app.config.ts eslint.config.js",
    "format:check": "prettier --check src tests scripts integration ../supabase/functions app.config.ts eslint.config.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "expo": "~57.0.31",
    "expo-constants": "~57.0.20",
    "expo-crypto": "~57.0.4",
    "expo-file-system": "~57.0.7",
    "expo-image": "~57.0.5",
    "expo-image-manipulator": "~57.0.21",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.13",
    "expo-router": "~57.0.29",
    "expo-screen-capture": "~57.0.4",
    "expo-secure-store": "~58.0.2",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@types/node": "^26.6.4",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "prettier": "^3.9.9",
    "supabase": "2.121.0",
    "typescript": "~6.0.3"
  }
}
