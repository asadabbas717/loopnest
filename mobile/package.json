{
  "name": "loopnest",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "expo-router/entry",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "expo start",
    "start:device": "expo start --go --lan",
    "backend:start": "node scripts/backend.mjs start",
    "backend:stop": "node scripts/backend.mjs stop",
    "backend:env": "node scripts/backend.mjs env",
    "maintenance:photos": "node scripts/maintenance.mjs",
    "test:integration": "node --test integration/*.test.mjs",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run typecheck && npm run lint && npm test",
    "audit:dependencies": "npm audit --audit-level=low",
    "test:dev-server": "node scripts/check-dev-server.mjs",
    "format": "prettier --write src tests scripts integration ../supabase/functions app.config.ts eslint.config.js",
    "format:check": "prettier --check src tests scripts integration ../supabase/functions app.config.ts eslint.config.js"
  },
  "dependencies": {
    "@expo-google-fonts/space-grotesk": "^0.4.1",
    "@expo/vector-icons": "^15.0.2",
    "@supabase/supabase-js": "^2.118.0",
    "expo": "~58.0.20",
    "expo-constants": "~58.0.13",
    "expo-crypto": "~58.0.7",
    "expo-file-system": "~58.0.12",
    "expo-font": "~58.0.10",
    "expo-image": "~58.0.17",
    "expo-image-manipulator": "~58.0.15",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.27",
    "expo-screen-capture": "~58.0.6",
    "expo-secure-store": "~58.0.2",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@types/node": "^26.6.4",
    "@types/react": "~19.3.0",
    "deepmerge": "file:vendor/deepmerge",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "jpeg-js": "0.4.4",
    "prettier": "^3.9.9",
    "supabase": "2.121.0",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "@expo/cli": {
      "zod": "4.6.7"
    },
    "@expo/config": {
      "deepmerge": "$deepmerge"
    }
  }
}
